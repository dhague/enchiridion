#!/bin/sh
# The one entrypoint every migrated skill and hook calls:
#
#   "${CLAUDE_PLUGIN_ROOT}/bin/enchiridion" search "<terms>" --json
#
# Resolves the platform binary — lazy-fetching it on first use via
# bootstrap/install.sh (docs/adr/0013) — and execs it with every argument
# passed through untouched. The plugin's own version, read from
# .claude-plugin/plugin.json, selects the release to fetch, so a plugin
# upgrade pulls the matching binary without anything else being edited.
#
# Two escape hatches, both for development against an unreleased binary:
#
#   ENCHIRIDION_BIN      absolute path to a binary to use as-is; nothing is
#                        downloaded. Set this to `go build`'s output when
#                        working on enchiridion-go.
#   ENCHIRIDION_VERSION  release version to fetch, overriding plugin.json.
#
# And one for callers that must not pay for a download:
#
#   ENCHIRIDION_NO_FETCH set to anything to use the cached binary if there is
#                        one and fail immediately if there isn't, instead of
#                        fetching. The PostToolUse hook sets it — it fires on
#                        every tool call, so it must never retry a failing
#                        download hundreds of times a session.
#
# Before falling back to the lazy-fetch bootstrap, prefer an already
# PATH-installed binary (docs/adr/0014 — brew/choco distribution as an
# optional accelerator over the fetch, never a signing substitute): if
# `enchiridion` resolves on PATH to something other than this script itself,
# its `version` output must match plugin.json's version exactly, or this
# halts rather than silently fetching a second, divergent binary — the halt
# is harmless in hooks (hooks.json already appends `|| exit 0`) and gives
# skills the one corrective command to surface.
#
# Deliberately POSIX sh for the same reason the bootstrap is: it must not
# depend on Python (the dependency this rewrite exists to remove) or on
# anything less universal than /bin/sh.

set -eu

plugin_root=$(unset CDPATH; cd -- "$(dirname -- "$0")/.." && pwd)

if [ -n "${ENCHIRIDION_BIN:-}" ]; then
    exec "$ENCHIRIDION_BIN" "$@"
fi

manifest="$plugin_root/.claude-plugin/plugin.json"

read_plugin_version() {
    [ -f "$manifest" ] || {
        echo "enchiridion: $manifest not found — cannot determine which release to fetch" >&2
        exit 1
    }
    # One `"version": "X.Y.Z"` line, no JSON parser required.
    v=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$manifest" | head -n 1)
    [ -n "$v" ] || {
        echo "enchiridion: no \"version\" in $manifest" >&2
        exit 1
    }
    echo "$v"
}

self=$(unset CDPATH; cd -- "$(dirname -- "$0")" && pwd)/$(basename -- "$0")

if path_bin=$(command -v enchiridion 2>/dev/null) && [ -n "$path_bin" ] && [ "$path_bin" != "$self" ] && [ "$path_bin" != "$0" ]; then
    path_version=$("$path_bin" version 2>/dev/null) || path_version=""
    if [ -n "$path_version" ]; then
        plugin_version=$(read_plugin_version)
        # Both sides may or may not carry a "v" prefix depending on how the
        # binary was built/tagged — normalize before comparing.
        path_version_norm=${path_version#v}
        plugin_version_norm=${plugin_version#v}
        if [ "$path_version_norm" = "$plugin_version_norm" ]; then
            exec "$path_bin" "$@"
        fi
        echo "enchiridion $path_version_norm is behind plugin $plugin_version_norm; run: brew upgrade enchiridion" >&2
        exit 1
    fi
fi

version=${ENCHIRIDION_VERSION:-}
if [ -z "$version" ]; then
    version=$(read_plugin_version)
fi

binary=$("$plugin_root/bootstrap/install.sh" "$plugin_root" "$version")
exec "$binary" "$@"
