#!/bin/sh
# The one entrypoint every migrated skill and hook calls:
#
#   "${CLAUDE_PLUGIN_ROOT}/bin/enchiridion" search "<terms>" --json
#
# A thin shim over the TypeScript port's esbuild bundle (ADR-0017,
# issue #254). Execs `node` against the bundle built from enchiridion-ts/,
# forwarding every argument untouched. This retires ADR-0013's lazy-fetch
# bootstrap: there is no download, no per-platform binary, and no PATH-
# preference check to make — `node` itself is the already-installed,
# already-trusted interpreter this rewrite exists to run inside of.
#
# One escape hatch, for development against unbundled source or an
# alternate runtime:
#
#   ENCHIRIDION_BIN   an executable to run as-is instead of `node <bundle>`;
#                     nothing else in this script runs. Point it at a
#                     `tsx`/`ts-node` invocation of enchiridion-ts/src/cli.ts
#                     to iterate without rebuilding, or at `bun` to exercise
#                     the OpenCode runtime locally.
#
# Deliberately POSIX sh (no Python, no Node-only shebang trick) so the shim
# itself never depends on the interpreter it is about to exec.

set -eu

plugin_root=$(unset CDPATH; cd -- "$(dirname -- "$0")/.." && pwd)

if [ -n "${ENCHIRIDION_BIN:-}" ]; then
    exec "$ENCHIRIDION_BIN" "$@"
fi

# enchiridion-ts/ is a sibling of wiki-plugin/ in this monorepo; packaging
# the bundle inside a distributed plugin directory (ADR-0017's "ships
# inside the plugin directory") is a later distribution ticket, not yet
# wired up here.
bundle="$plugin_root/../enchiridion-ts/dist/cli.js"

exec node "$bundle" "$@"
