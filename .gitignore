# Resilio Sync scratch artifacts — this repo lives inside a synced folder.
*.rsls

# Per-session transcript_path state written by the wiki-knowledge plugin's
# SessionStart hook (wiki-plugin/hooks/store_transcript_path.py) — see #23.
# The hooks write relative to whatever cwd a command ran in, so this is
# matched at any depth rather than listing each subdirectory that has caught
# one.
**/.claude/wiki-knowledge/sessions/
.mcp.json
tmp/
.lsp.json
opencode.json
